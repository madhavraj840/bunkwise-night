<Window x:Class="NightMode.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NightMode"
        Title="Night mode" Width="372" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Ui}" FontSize="14"
        Background="{DynamicResource Nm.Surface}"
        Foreground="{DynamicResource Nm.Text}">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
    <Grid x:Name="Root" Margin="18,18,18,14">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <StackPanel>

            <Border x:Name="Intro" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="13"
                               Text="Night mode lives in the tray. No moon icon on the taskbar? Click the ^ arrow and drag it out." />
                    <Button Content="Got it" Style="{StaticResource Ghost}" HorizontalAlignment="Right" Margin="0,10,0,0" MinWidth="80" Click="Intro_Click" />
                </StackPanel>
            </Border>

            <Border x:Name="ProblemBox" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed"
                    BorderBrush="{DynamicResource Nm.Danger}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE783;" VerticalAlignment="Top"
                               Margin="0,1,10,0" Foreground="{DynamicResource Nm.Danger}" />
                    <TextBlock x:Name="ProblemText" TextWrapping="Wrap" FontSize="13" />
                </DockPanel>
            </Border>

            <!-- header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Night mode" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource Nm.Text2}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ToggleButton x:Name="OnSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                              AutomationProperties.Name="Night mode" Checked="OnSwitch_Click" Unchecked="OnSwitch_Click" />
            </Grid>

            <!-- readout -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Bottom" FontFamily="{StaticResource Mono}" FontWeight="Medium" LineHeight="52"
                           LineStackingStrategy="BlockLineHeight" AutomationProperties.Name="Dim level">
                    <Run x:Name="BigNum" FontSize="56" /><Run Text="%" FontSize="22" Foreground="{DynamicResource Nm.Text2}" />
                </TextBlock>
                <Grid Grid.Column="1" VerticalAlignment="Bottom" TextElement.FontSize="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" MinWidth="52" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="MetaBlLabel" Text="Backlight" Foreground="{DynamicResource Nm.Text3}" HorizontalAlignment="Right" Margin="0,0,10,4" />
                    <TextBlock x:Name="MetaBl" Grid.Column="1" FontFamily="{StaticResource Mono}" />
                    <TextBlock x:Name="MetaSzLabel" Grid.Row="1" Text="Sub-zero" Foreground="{DynamicResource Nm.Text3}" HorizontalAlignment="Right" Margin="0,0,10,4" />
                    <TextBlock x:Name="MetaSz" Grid.Row="1" Grid.Column="1" FontFamily="{StaticResource Mono}" />
                    <TextBlock Grid.Row="2" Text="Colour" Foreground="{DynamicResource Nm.Text3}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                    <TextBlock x:Name="MetaColour" Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource Mono}" />
                </Grid>
            </Grid>

            <local:Scale x:Name="DimScale" Margin="0,16,0,0" AutomationProperties.Name="Dim level, percent"
                         ValueChanged="DimScale_ValueChanged" />

            <UniformGrid x:Name="PresetPanel" Columns="4" Margin="-3,6,-3,0" />
            <Button x:Name="SaveBtn" Style="{StaticResource NavRow}" MinHeight="30" HorizontalAlignment="Left" Margin="-8,2,0,0"
                    Click="Save_Click" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE710;" Foreground="{DynamicResource Nm.Text2}" Margin="0,0,8,0" />
                    <TextBlock x:Name="SaveText" FontSize="12" Foreground="{DynamicResource Nm.Text2}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border x:Name="PausedRow" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="13" VerticalAlignment="Center">
                        <Run Text="Paused · dims again in" /> <Run x:Name="PausedLeft" FontFamily="{StaticResource Mono}" FontWeight="Medium" />
                    </TextBlock>
                    <Button Grid.Column="1" Content="Resume now" Style="{StaticResource AccentBtn}" Click="Resume_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Hairline}" Margin="0,16,0,8" />

            <!-- colour -->
            <Grid MinHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Colour" FontSize="13" VerticalAlignment="Center" />
                <Border Grid.Column="1" Style="{StaticResource SegBox}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="NaturalRadio" Style="{StaticResource SegChoice}" GroupName="Colour" Content="Natural" Checked="Colour_Checked" />
                        <RadioButton x:Name="WarmRadio" Style="{StaticResource SegChoice}" GroupName="Colour" Content="Warm" Checked="Colour_Checked" />
                        <RadioButton x:Name="GreyRadio" Style="{StaticResource SegChoice}" GroupName="Colour" Content="Grey" Margin="0" Checked="Colour_Checked"
                                     ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="WarmRow" MinHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Warmth" FontSize="13" VerticalAlignment="Center" />
                <Slider x:Name="WarmSlider" Grid.Column="1" Style="{StaticResource MiniSlider}" Minimum="5" Margin="14,0,8,0"
                        AutomationProperties.Name="Warmth, percent" ValueChanged="WarmSlider_ValueChanged" />
                <TextBlock x:Name="WarmValue" Grid.Column="2" FontFamily="{StaticResource Mono}" FontSize="12" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="{DynamicResource Nm.Text2}" />
            </Grid>
            <Grid x:Name="PauseRow" MinHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Pause" FontSize="13" VerticalAlignment="Center" />
                <Border Grid.Column="1" Style="{StaticResource SegBox}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SegButton}" Content="30 s" Tag="30" Click="Pause_Click"
                                AutomationProperties.Name="Pause dimming for 30 seconds" />
                        <Button Style="{StaticResource SegButton}" Content="1 min" Tag="60" Click="Pause_Click"
                                AutomationProperties.Name="Pause dimming for 1 minute" />
                        <Button Style="{StaticResource SegButton}" Content="5 min" Tag="300" Margin="0" Click="Pause_Click"
                                AutomationProperties.Name="Pause dimming for 5 minutes" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- more -->
            <StackPanel Margin="-8,8,-8,0">
                <Button Style="{StaticResource NavRow}" Tag="schedule" Click="Nav_Click" AutomationProperties.Name="Schedule">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" Foreground="{DynamicResource Nm.Text2}" />
                        <TextBlock Grid.Column="1" Text="Schedule" VerticalAlignment="Center" />
                        <TextBlock x:Name="ScheduleText" Grid.Column="2" FontFamily="{StaticResource Mono}" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Nm.Text2}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource NavRow}" Tag="apps" Click="Nav_Click" AutomationProperties.Name="App rules">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" Foreground="{DynamicResource Nm.Text2}" />
                        <TextBlock Grid.Column="1" Text="App rules" VerticalAlignment="Center" />
                        <TextBlock x:Name="RulesText" Grid.Column="2" FontFamily="{StaticResource Mono}" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Nm.Text2}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource NavRow}" Tag="dimming" Click="Nav_Click" AutomationProperties.Name="Settings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Foreground="{DynamicResource Nm.Text2}" />
                        <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Glyph}" FontSize="12" Text="&#xE76C;"
                                   Foreground="{DynamicResource Nm.Text3}" />
                    </Grid>
                </Button>
            </StackPanel>

            <!-- the way out -->
            <Line Margin="0,10,0,0" X2="1" Stretch="Fill" StrokeThickness="1" StrokeDashArray="3,3"
                  Stroke="{DynamicResource Nm.LineStrong}" />
            <WrapPanel Margin="0,12,0,0" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Nm.Text2}">
                <TextBlock Text="Can't see the screen?" Margin="0,0,6,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Kbd}" Margin="0,0,4,0"><TextBlock Text="Ctrl" /></Border>
                <Border Style="{StaticResource Kbd}" Margin="0,0,4,0"><TextBlock Text="Alt" /></Border>
                <Border Style="{StaticResource Kbd}" Margin="0,0,6,0"><TextBlock Text="Backspace" /></Border>
                <TextBlock Text="for full brightness." VerticalAlignment="Center" />
            </WrapPanel>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
