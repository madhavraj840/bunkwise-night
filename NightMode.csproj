<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Magnification API does not run under WOW64 -->
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>NightMode</AssemblyName>
    <RootNamespace>NightMode</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NightMode.ico</ApplicationIcon>
    <Version>1.1.1</Version>
    <Product>Night mode</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="checks\**" />
    <None Remove="checks\**" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Resource Include="Assets\NightMode.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\OFL.txt" Link="Geist-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
